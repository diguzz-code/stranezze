{
    "name": "stranezze/app",
    "description": "Applicazione Stranezze",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "robmorgan/phinx": "^0.16",
        "vlucas/phpdotenv": "^5.6",
        "nikic/fast-route": "^1.3"
    },
    "scripts": {
    "migrate": "@php vendor/robmorgan/phinx/bin/phinx migrate -e development",
    "migrate:rollback": "@php vendor/robmorgan/phinx/bin/phinx rollback -e development",
    "migrate:production": "@php vendor/robmorgan/phinx/bin/phinx migrate -e production"
    },
    "autoload": {
        "psr-4": {
            "Stranezze\\": "src/"
        }
    }
}
